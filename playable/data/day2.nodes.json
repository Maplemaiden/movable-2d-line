  "D2-05": {
    "id": "D2-05",
    "title": "肠老头的晚饭",
    "room": "room_kitchen",
    "lockDoors": true,
    "showNpcs": ["sisi", "boss", "liuaiguo", "licuilan"],
    "npcPose": {
      "sisi": { "x": 980, "sprite": "sisi_idle" },
      "boss": { "x": 1220, "sprite": "boss_idle" },
      "liuaiguo": { "x": 1480, "sprite": "liuaiguo_idle" },
      "licuilan": { "x": 1720, "sprite": "licuilan_idle" }
    },
    "briefing": [
      { "speaker": "旁白", "text": "爷爷炒了满桌。香味很浓。浓得像刚从别处搬来的。" },
      { "speaker": "danmaku", "text": "那盘绝对是肠吧……她还吃？" }
    ],
    "autoDialogue": true,
    "dialogue": [
      {
        "speaker": "liuaiguo",
        "text": "尝尝，爷爷的拿手菜。补身子。",
        "portrait": "yeye_front"
      },
      {
        "speaker": "sisi",
        "text": "……爷爷又把毛衣煮进锅里了。",
        "portrait": "sisi_front",
        "side": "right"
      },
      {
        "speaker": "旁白",
        "text": "我看不太清食材。这很好。",
        "horror": 6,
        "horrorReason": "晚饭来源可疑，胃先紧了一下",
        "when": { "flags.coldDinner": false }
      },
      {
        "speaker": "旁白",
        "text": "昨天推过盘子。今晚再拒，爷爷会记得。",
        "horror": 8,
        "horrorReason": "冷桌记忆叠加，晚饭更难以下咽",
        "when": { "flags.coldDinner": true }
      }
    ],
    "choices": [
      {
        "text": "吃一口，夸好吃",
        "when": { "flags.grandmaFaceMask": true },
        "effects": {
          "flags.grandpaCookOk": true,
          "flags.coldDinner": false,
          "inventory.ateStrangeFood": true,
          "familyTrust.liuaiguo": 2,
          "horror": -10,
          "horrorReason": "夸爷爷做饭，把可疑食材写成家常"
        },
        "next": "D2-06"
      },
      {
        "text": "我来帮厨",
        "when": { "flags.refuseMother": false },
        "effects": {
          "flags.grandpaCookOk": true,
          "flags.coldDinner": false,
          "familyTrust.liuaiguo": 1,
          "familyTrust.licuilan": 1,
          "familyTrust.sisi": 1,
          "familyTrust.boss": 1,
          "horror": -14,
          "horrorReason": "下厨照顾全家，惊悚回落"
        },
        "next": "D2-06"
      },
      {
        "text": "先动筷，不追问",
        "effects": {
          "flags.grandpaCookOk": true,
          "inventory.ateStrangeFood": true,
          "horror": 4,
          "horrorReason": "硬吃但没完成夸奖，不适残留"
        },
        "next": "D2-06"
      },
      {
        "text": "掀桌 / 这是肠子吧？",
        "when": { "flags.refuseMother": true },
        "effects": {
          "flags.grandpaCookOk": false,
          "flags.coldDinner": true,
          "familyTrust.liuaiguo": -1,
          "familyTrust.sisi": -1,
          "horror": 16,
          "horrorReason": "当众掀桌质问肠子，冷家固化"
        },
        "next": "D2-06"
      }
    ],
    "aiStage": "D2_GRANDPARENTS"
  },
  "D2-06": {
    "id": "D2-06",
    "title": "夜 · 家庭磨合",
    "room": "room_bedroom",
    "night": true,
    "lockDoors": true,
    "showNpcs": ["sisi", "boss"],
    "npcPose": {
      "sisi": { "x": 980, "sprite": "sisi_idle" },
      "boss": { "x": 1450, "sprite": "boss_idle" }
    },
    "briefing": [
