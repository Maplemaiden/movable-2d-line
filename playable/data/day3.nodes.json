      "room_bathroom"
    ],
    "showNpcs": ["sisi", "boss"],
    "npcPose": {
      "sisi": { "x": 980, "sprite": "sisi_idle" },
      "boss": { "x": 1450, "sprite": "boss_idle" }
    },
    "ending": true,
    "endTitle": "第三天结束",
    "endDesc": "拜访从明天开始。家人不能随行。刀与红裙会改变你在楼里的气场。",
    "endNext": "D4-00",
    "autoDialogue": true,
    "dialogue": [
      {
        "speaker": "system",
        "text": "第三天结算。安全日到头了。明天下楼拿卡——选项仍汇流，不卡死。"
      }
    ],
    "choices": [
      { "text": "进入结算", "effects": { "flags.day3_cleared": true }, "next": null, "showEnd": true }
    ],
    "aiStage": "D3_VISIT_BRIEF"
  }
}
